# Anime Compass on Vercel container functions.
#
# Same application, same artifacts, same models as the Hugging Face Spaces
# image in `Dockerfile`. Only three things differ, and all three come from the
# platform rather than from any choice about how the recommender behaves:
#
#   1. The server binds Vercel's $PORT instead of a fixed 7860.
#   2. Everything the process reads at runtime is baked into the image, because
#      container functions scale to zero and a cold start should not spend its
#      first half-minute downloading 192 MB of artifacts and 90 MB of weights.
#   3. Writable state lives in /tmp, because the function filesystem does not
#      persist between invocations.
#
# FastAPI still serves `frontend/` at `/`, so the browser sees one origin and
# needs no CORS and no separate frontend deployment.
#
# ---------------------------------------------------------------------------
# PyTorch here is the CPU build
#
# The default PyPI wheel carries a CUDA stack that this deployment can never
# use: the function has no GPU and EMBEDDING_DEVICE is cpu. It is not a small
# amount of dead weight. The first push failed at 413 PAYLOAD_TOO_LARGE, and
# the attempt to fix that by splitting torch across layers then filled the
# build workspace outright -- the partitions came to 6.3 GB and the build died
# with "no space left on device" before it ever reached the registry.
#
# The cause is seven dependencies the wheel declares under
# `platform_system == "Linux"`, which is why none of them appear in local
# development on Windows or macOS: cuda-toolkit with eleven extras,
# cuda-bindings, nvidia-cudnn-cu13, nvidia-cusparselt-cu13, nvidia-nccl-cu13,
# nvidia-nvshmem-cu13 and triton.
#
# Installing the CPU build removes all of it, and with it the reason for the
# layer surgery that used to live in this file:
#
#                        default wheel      CPU wheel
#     compressed            554.6 MB         196.3 MB
#     unpacked             1144.2 MB         715.5 MB
#     CUDA dependencies            7                0
#     largest member        356.0 MB          115.7 MB   (libtorch_cpu.so)
#
# No single layer is near the registry's 500 MB compressed limit any more, so
# torch is installed in one step and everything else in another. The version is
# unchanged: 2.14.0 in both cases, differing only in which binaries were built.
# ---------------------------------------------------------------------------

FROM python:3.12-slim

# Pinned by revision, not by tag: the embedding matrix in the artifact repo was
# produced by exactly this model, and a silently newer revision would put the
# precomputed document vectors and the live query vectors in different spaces.
ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ARG EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
ARG HF_DATASET_REPO=Seiitsu/anime-compass-data
ARG HF_DATASET_REVISION=main

RUN useradd -m -u 1000 user

ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000 \
    EMBEDDING_PROVIDER=sentence_transformers \
    EMBEDDING_MODEL=${EMBEDDING_MODEL} \
    EMBEDDING_MODEL_REVISION=${EMBEDDING_MODEL_REVISION} \
    EMBEDDING_DIMENSIONS=384 \
    EMBEDDING_DEVICE=cpu \
    EMBEDDING_LOCAL_FILES_ONLY=true \
    HF_DATASET_REPO=${HF_DATASET_REPO} \
    HF_DATASET_REVISION=${HF_DATASET_REVISION} \
    HF_HOME=/home/user/.cache/huggingface \
    DATABASE_URL=sqlite:////tmp/anime_compass.db \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER user
WORKDIR $HOME/app

COPY --chown=user requirements-api.txt requirements-embeddings.txt requirements-web.txt \
                  requirements-vercel.txt constraints-vercel.txt ./

# 1. PyTorch, CPU build, in a layer of its own (~196 MB compressed).
RUN pip install --no-cache-dir --user -r requirements-vercel.txt

# 2. Everything else. The constraints file is what keeps step 1 intact:
#    sentence-transformers depends on torch, and without the pin this install
#    would happily satisfy that from PyPI and drag the whole CUDA stack back
#    in. The pin is unsatisfiable anywhere but the PyTorch CPU index, so that
#    substitution fails the build instead of happening silently.
RUN pip install --no-cache-dir --user -c constraints-vercel.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements-web.txt

# 3. Prove the result rather than trusting it. `pip check` verifies the
#    dependency closure is complete and consistent; the rest fails the build if
#    a CUDA-enabled torch or any NVIDIA/Triton package got in by any route.
RUN pip check \
 && python -c "import torch; print('torch.__version__ =', torch.__version__); print('torch.version.cuda =', torch.version.cuda); print('torch.cuda.is_available() =', torch.cuda.is_available()); assert torch.version.cuda is None, 'CUDA-enabled torch in a CPU-only image'; assert not torch.cuda.is_available(), 'CUDA runtime visible in a CPU-only image'; assert torch.__version__.startswith('2.14.0'), torch.__version__" \
 && if pip list --format=freeze | grep -Eiq '^(nvidia-|triton|cuda-)'; then \
        echo 'CUDA packages present in a CPU-only image:'; \
        pip list --format=freeze | grep -Ei '^(nvidia-|triton|cuda-)'; \
        exit 1; \
    else \
        echo 'no NVIDIA, CUDA or Triton packages installed'; \
    fi \
 && du -sh /home/user/.local

# 4. Model weights. EMBEDDING_LOCAL_FILES_ONLY makes the running container read
#    this cache and never reach the network, so if this step were missing the
#    application would fail at startup rather than quietly downloading.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBEDDING_MODEL}', revision='${EMBEDDING_MODEL_REVISION}', device='cpu', trust_remote_code=False)"

# 5. Runtime artifacts, checksum-verified against data/artifacts.manifest.json.
#    Only the manifest and the downloader are copied here, so a change anywhere
#    else in the tree does not re-download 192 MB.
#
#    `data/processed` is in .dockerignore, so these files exist only because
#    this step created them. The application calls the same routine at startup;
#    finding every file present and matching, it verifies and returns instead
#    of downloading.
COPY --chown=user data/artifacts.manifest.json data/artifacts.manifest.json
COPY --chown=user scripts/download_artifacts.py scripts/download_artifacts.py
RUN python scripts/download_artifacts.py \
        --repo-id "${HF_DATASET_REPO}" \
        --revision "${HF_DATASET_REVISION}"

# 6. Application source, including frontend/ which FastAPI mounts at /.
COPY --chown=user . .

# Documentation only: Vercel injects $PORT and the CMD below honours it.
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT','8000')}/api/ready\", timeout=3)" || exit 1

# Shell form so $PORT expands at run time, and `exec` so uvicorn becomes PID 1
# and receives SIGTERM directly. Without exec the shell would hold PID 1, the
# signal would go to it instead, and a scale-to-zero shutdown would be a kill
# rather than a graceful drain.
CMD ["sh", "-c", "exec python run_app.py --host 0.0.0.0 --port ${PORT:-8000}"]
