# Keep raw Kaggle data out of Git; the processed catalog is enough for deployment.
Anime Data/**/*.csv
data/raw/*.csv
/anime.csv
/anime_with_synopsis.csv
/animelist.csv
/rating_complete.csv
/watching_status.csv
/html folder/
archive/*.csv
archive/html/
archive/html folder/

# Generated artifacts stay local or live in the companion Hugging Face Dataset
# repository. Keep only their checksummed manifest in GitHub source control.
data/processed/*.json
data/processed/*.npz
# Serving models live with the other hosted artifacts, not in Git.
data/processed/*.txt

# Personalized benchmark splits and train-only model artifacts are reproducible
# but too large for source control. Reports under results/ stay reviewable.
data/evaluation/personalized/splits/
data/evaluation/personalized/artifacts/
# Sweep candidates write their model artifacts beside their reports; keep the
# reports, drop the weights (76 MB of reproducible .npz).
data/evaluation/personalized/results/**/artifacts/

# Local OS/editor files.
.DS_Store
Thumbs.db
.vscode/
.idea/
