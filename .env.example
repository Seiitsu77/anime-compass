# Public deployments can use Gemini; local development can use Ollama.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=sqlite:///data/anime_compass.db
SESSION_RETENTION_DAYS=30
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
SESSION_CLEANUP_INTERVAL_SECONDS=3600
LLM_TIMEOUT_SECONDS=35
LLM_MAX_OUTPUT_TOKENS=1200
MAX_CONVERSATION_HISTORY=12
# Bounded deterministic constraint relaxation for over-constrained requests (0 disables).
MAX_REPLAN_STEPS=2

# Production ALS. Two artifacts exist and must not be confused: the evaluation
# build withholds held-out positives and backs every published metric, while the
# production build trains on all positives and is invalid for measuring.
# ALS_EXPECTED_ROLE guards against serving the wrong one.
ALS_ENABLED=true
ALS_ARTIFACT_PATH=data/processed/als_production_item_factors.npz
ALS_EXPECTED_ROLE=production
# The Streamlit demo reads its pins from data/artifacts.manifest.json. Set these
# overrides for FastAPI deployments or when serving a replacement artifact.
# A checksum or catalog mismatch refuses startup instead of quietly serving a
# model that no longer matches. ALS_ARTIFACT_URL is optional when the file is
# already present on disk.
ALS_ARTIFACT_URL=
ALS_EXPECTED_SHA256=
ALS_EXPECTED_CATALOG_IDS_SHA256=
# Refuse to start on any ALS validation failure, not just a pinned mismatch.
ALS_REQUIRE_VALID_ARTIFACT=false

# Serving catalog for the Streamlit demo. Only the fields the demo reads:
# 6.6 MB rather than 119 MB, for identical recommendations. Build it with
# `python scripts/build_serving_catalog.py`, or let SERVING_CATALOG_URL fetch it.
# The demo falls back to the full catalog only in development.
# SERVING_CATALOG_URL is an optional external replacement and is verified the
# same way as the ALS artifact.
SERVING_CATALOG_PATH=data/processed/anime_catalog_serving.json
SERVING_CATALOG_URL=
SERVING_CATALOG_EXPECTED_SHA256=

# Learned second-stage reranker, promoted to production. NDCG@10 0.2456 ->
# 0.2828 on its untouched 800-user confirmation set. On by default; the fast
# path serves the verified ALS order whenever the reranker cannot load, and
# /api/health reports which of the two is actually serving. It adds LightGBM
# and about 18 MB of artifacts; see docs/ARCHITECTURE.md.
RERANKER_ENABLED=true
RERANKER_FEATURE_PATH=data/processed/reranker_features.npz
RERANKER_MODEL_PATH=data/processed/reranker_lambdamart.txt
RERANKER_FEATURE_SHA256=
RERANKER_MODEL_SHA256=

# Fast-path retrieval and routing. Defaults are the measured operating point;
# see docs/ARCHITECTURE.md before changing them.
RETRIEVAL_ALS_TOP_N=300
RETRIEVAL_ITEM_ITEM_TOP_M=0
ROUTING_SEGMENT_AWARE=false
ROUTING_MEDIUM_THRESHOLD=5
FAST_PATH_DIVERSITY_STRENGTH=0.0
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=60

# Optional public Hugging Face Dataset repo. At startup, missing or stale catalog
# artifacts are downloaded and verified against data/artifacts.manifest.json.
HF_DATASET_REPO=
HF_DATASET_REVISION=main

# The compact collaborative artifact is built from anonymous completed-title
# ratings and loads without a separate ML framework.
COLLABORATIVE_ENABLED=true
COLLABORATIVE_ARTIFACT_PATH=data/processed/collaborative_embeddings.npz

# Optional semantic channel. Build a fresh artifact for the active catalog before
# switching this from "none" to "sentence_transformers".
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_LOCAL_FILES_ONLY=true
SEMANTIC_ARTIFACT_PATH=data/processed/semantic_embeddings.npz
